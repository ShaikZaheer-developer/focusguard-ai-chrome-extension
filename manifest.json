{
  "manifest_version": 3,
  "name": "FocusGuard - AI Screen Time Coach",
  "version": "1.0.0",
  "description": "Block distracting sites, track screen time, run focus sessions, and get AI-style weekly focus reports.",
  "permissions": ["storage", "tabs", "alarms", "notifications", "idle"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGuard"
  },
  "options_page": "dashboard.html",
  "chrome_url_overrides": {},
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "assets.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
